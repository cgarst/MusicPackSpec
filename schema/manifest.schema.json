{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpak:schema:manifest:1",
  "title": "Music Pack manifest, version 1",
  "description": "manifest.json inside a .mpak archive. Unknown fields are allowed and ignored by readers.",
  "type": "object",
  "required": ["format", "version", "scores"],
  "properties": {
    "format": { "const": "mpak" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "The identity of the pack; kept when it is edited or copied for the same song (SPEC 4, Pack identity)." },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "song": { "$ref": "#/$defs/song" },
    "scores": {
      "type": "array",
      "minItems": 1,
      "description": "The scores of the song. The first is the primary score (SPEC 6).",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/score" },
          {
            "required": ["id"],
            "properties": {
              "alternates": {
                "type": "array",
                "description": "Scores derived from this one that share its sync points (SPEC 6.3).",
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/score" },
                    { "required": ["id"] }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "recordings": {
      "type": "array",
      "items": { "$ref": "#/$defs/recording" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archivePath": {
      "type": "string",
      "description": "Relative, UTF-8, '/' separated, no empty or '..' segment, no backslash.",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f]+$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "song": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "composer": { "type": "string" },
        "album": { "type": "string" },
        "genre": { "type": "string" },
        "publisher": { "type": "string" },
        "year": { "type": "integer" },
        "trackNumber": { "type": "integer", "minimum": 0 },
        "mediumNumber": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0, "description": "Milliseconds." },
        "ids": {
          "type": "object",
          "properties": {
            "musicbrainz": {
              "type": "object",
              "properties": {
                "recording": { "$ref": "#/$defs/uuid" },
                "artist": { "$ref": "#/$defs/uuid" },
                "release": { "$ref": "#/$defs/uuid" },
                "releaseGroup": { "$ref": "#/$defs/uuid" }
              }
            },
            "isrc": { "type": "string" }
          }
        }
      }
    },
    "score": {
      "type": "object",
      "required": ["format", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "path": { "$ref": "#/$defs/archivePath" },
        "externalPath": { "$ref": "#/$defs/archivePath" },
        "format": { "enum": ["gp3", "gp4", "gp5", "gp", "gpx", "musicxml", "mxl", "mscz", "midi", "abc", "alphatex", "pdf", "txt"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "name": { "type": "string" },
        "pages": { "type": "integer", "minimum": 1 },
        "startPage": { "type": "integer", "minimum": 1 },
        "endPage": { "type": "integer", "minimum": 1 },
        "instruments": {
          "type": "array",
          "items": { "$ref": "#/$defs/instrument" }
        }
      },
      "oneOf": [
        { "required": ["path"] },
        { "required": ["externalPath"] }
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["externalPath"] },
              { "required": ["startPage"] },
              { "required": ["endPage"] }
            ]
          },
          "then": {
            "properties": { "format": { "const": "pdf" } }
          }
        }
      ]
    },
    "instrument": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tuning": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-G][#b]?(-?[0-9])?$" },
          "minItems": 1
        },
        "capo": { "type": "integer", "minimum": 1 }
      }
    },
    "recording": {
      "type": "object",
      "required": ["id", "role", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "minLength": 1, "description": "Open vocabulary. Defined: original, backing, stem, alternate, solo." },
        "label": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "sync": {
          "type": "object",
          "description": "Sync file paths, keyed by score id (SPEC 9).",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/archivePath" }
        },
        "syncFrom": { "$ref": "#/$defs/id" },
        "syncOffsetMs": { "type": "integer", "description": "Added to the points and beats inherited through syncFrom. May be negative." },
        "beats": { "$ref": "#/$defs/archivePath", "description": "Beat file of this recording (SPEC 7, Beat file)." },
        "scoreTracks": {
          "type": "object",
          "description": "Tracks present in or missing from the audio, keyed by score id (SPEC 7).",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "omits": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
              "only": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
              "names": { "type": "array", "items": { "type": "string" } }
            },
            "oneOf": [{ "required": ["omits"] }, { "required": ["only"] }]
          }
        },
        "without": {
          "type": "array",
          "uniqueItems": true,
          "description": "Ids of stems whose parts are not in this recording's audio (SPEC 8).",
          "items": { "$ref": "#/$defs/id" }
        },
        "stemOf": { "$ref": "#/$defs/id" },
        "stemsComplete": { "type": "boolean" },
        "stem": {
          "type": "object",
          "properties": {
            "instrument": { "type": "string" },
            "track": { "type": "integer", "minimum": 0 },
            "trackName": { "type": "string" }
          }
        }
      },
      "allOf": [
        { "if": { "required": ["stemOf"] }, "then": { "properties": { "role": { "const": "stem" } } } },
        { "dependentRequired": { "syncOffsetMs": ["syncFrom"] } }
      ]
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "description": "Defined: file, youtube, url, embedded, external. Unknown types are skipped by readers." },
        "id": { "$ref": "#/$defs/id" },
        "offsetMs": { "type": "number" },
        "durationMs": { "type": "number", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "derivedFrom": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "embedded" } }, "required": ["type"] },
          "then": {
            "properties": { "score": { "$ref": "#/$defs/id" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "file" } }, "required": ["type"] },
          "then": {
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/archivePath" },
              "mime": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "youtube" } }, "required": ["type"] },
          "then": {
            "required": ["videoId"],
            "properties": { "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "url" } }, "required": ["type"] },
          "then": {
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "pattern": "^https?://" },
              "mime": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
