{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpak:schema:sync:1",
  "title": "Music Pack sync file, version 1",
  "description": "A sync file under sync/ in a .mpak archive. Aligns one score to one recording. anchorType must match the format of that score in the manifest (bar, tick, pdf or text). For anchorType bar, points are objects, or bare numbers: the start of each played bar in seconds.",
  "type": "object",
  "required": [
    "version",
    "recording",
    "score",
    "anchorType",
    "points"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "recording": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "score": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "anchorType": {
      "enum": [
        "bar",
        "tick",
        "pdf",
        "text"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "points": {
      "type": "array"
    },
    "revisionId": {
      "type": [
        "integer",
        "string"
      ],
      "description": "An identifier, from the service the times came from, of the version of the score they were made for. Informational."
    },
    "videoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$",
      "description": "The YouTube video the times were made against. Informational."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "anchorType": {
            "const": "bar"
          }
        },
        "required": []
      },
      "then": {
        "properties": {
          "points": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/barPoint"
                }
              },
              {
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "anchorType": {
            "const": "tick"
          }
        }
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/$defs/tickPoint"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "anchorType": {
            "const": "pdf"
          }
        }
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/$defs/pdfPoint"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "anchorType": {
            "const": "text"
          }
        }
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/$defs/textPoint"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": [
        "timeMs"
      ],
      "properties": {
        "timeMs": {
          "type": "number",
          "minimum": 0,
          "description": "Milliseconds on the recording's timeline."
        },
        "source": {
          "enum": [
            "tap",
            "manual",
            "auto"
          ],
          "default": "manual"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "barPoint": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "bar"
      ],
      "properties": {
        "bar": {
          "type": "integer",
          "minimum": 0
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "pos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        }
      }
    },
    "tickPoint": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "tick"
      ],
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pdfPoint": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Horizontal position. With y, or neither."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "dependentRequired": {
        "x": [
          "y"
        ],
        "y": [
          "x"
        ]
      }
    },
    "textPoint": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "required": [
        "line"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
